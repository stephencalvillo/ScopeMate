# App
# Local dev only. On Vercel, set this to your production URL (e.g. https://scopebuddy.com; interim: https://myscopemate.ai)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk ? https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/projects
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/projects
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/
# Set to "false" on production to hide Google sign-in until OAuth is configured.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
# Do NOT set NEXT_PUBLIC_CLERK_PROXY_URL for development Clerk keys (pk_test_*).
# Production (scopebuddy.ai): set to /__clerk and enable the proxy in Clerk Domains.
NEXT_PUBLIC_CLERK_PROXY_URL=/__clerk

# Supabase ? https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Database (for running migrations locally ? Supabase ? Settings ? Database ? URI)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# OpenAI ? https://platform.openai.com
OPENAI_API_KEY=sk-...

# Admin panel (/adminpanel) — comma-separated allowlist
ADMIN_EMAILS=admin@scopebuddy.ai
# Optional: allow by Clerk user ID instead of or in addition to email
# ADMIN_USER_IDS=user_2abc...

# Optional
OPENAI_MODEL=gpt-4o
SCOPE_PROMPT_VERSION=scope-v1
FOLLOW_UP_PROMPT_VERSION=follow-up-v1
MAX_FOLLOW_UP_QUESTIONS=5
MAX_PHOTOS_PER_PROJECT=10
MAX_PHOTO_BYTES=10485760
SUPABASE_PROJECT_PHOTOS_BUCKET=project-photos
SHARE_TOKEN_BYTES=32
RATE_LIMIT_SCOPE_GENERATION=10

# Resend (transactional email) - https://resend.com
# Dev: onboarding@resend.dev (sends only to your Resend account email)
# Prod: verify scopebuddy.ai on Resend and use e.g. ScopeBuddy <hello@scopebuddy.ai>
RESEND_API_KEY=re_...
EMAIL_FROM=ScopeBuddy <hello@scopebuddy.ai>
